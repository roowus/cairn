# ──────────────────────────────────────────────────────────────────────
# Cairn configuration. Copy to `.env` (or set as shell env vars) and edit.
#   cp .env.example .env
# Config precedence: real env vars > ~/.cairn/.env > ./.env > ~/.cairn/config.toml
# In the REPL, switch profiles anytime with:  /model   or   /model grok
# ──────────────────────────────────────────────────────────────────────

# ── LLM provider ─────────────────────────────────────────────────────
# There is NO default provider. Pick ONE. base_url is only needed for
# Ollama or any OpenAI-compatible gateway. Credentials for xAI / Z.AI can
# also be pulled automatically from ~/.pi/agent/auth.json when api_key is
# left unset (same store the `pi` coding agent uses).
#
# Option A — xAI Grok (subscription OAuth via `pi` /login xai, or API key):
CAIRN_LLM__PROVIDER=xai
CAIRN_LLM__MODEL=grok-4.5
# CAIRN_LLM__API_KEY=           # optional; falls back to pi auth / XAI_API_KEY
# XAI_API_KEY=
#
# Option B — Anthropic (Claude):
# CAIRN_LLM__PROVIDER=anthropic
# CAIRN_LLM__MODEL=claude-sonnet-5
# CAIRN_LLM__API_KEY=sk-ant-...
# CAIRN_LLM__BASE_URL=
#
# Option C — OpenAI:
# CAIRN_LLM__PROVIDER=openai
# CAIRN_LLM__MODEL=gpt-4o
# CAIRN_LLM__API_KEY=sk-...
#
# Option D — Local Ollama (no real key needed; OpenAI-compatible):
# CAIRN_LLM__PROVIDER=openai
# CAIRN_LLM__MODEL=llama3.1
# CAIRN_LLM__BASE_URL=http://localhost:11434/v1
# CAIRN_LLM__API_KEY=ollama
#
# Option E — Z.AI GLM-5.2 (FREE, OpenAI-compatible, strong reasoning):
#   key is in ~/.pi/agent/auth.json -> zai.key if you use the `pi` CLI
# CAIRN_LLM__PROVIDER=openai
# CAIRN_LLM__BASE_URL=https://api.z.ai/api/coding/paas/v4
# CAIRN_LLM__MODEL=glm-5.2
# CAIRN_LLM__API_KEY=<your zai key>
# Also switchable at runtime: /model glm

# ── Optional paid-source keys ─────────────────────────────────────────
# A plugin activates automatically once its key is set.
# CAIRN_SHODAN_KEY=
# CAIRN_VIRUSTOTAL_KEY=
# CAIRN_CENSYS_KEY=
# CAIRN_ABUSEIPDB_KEY=
# CAIRN_HIBP_KEY=
# CAIRN_BRAVE_KEY=
# CAIRN_EXA_KEY=
# Optional rate-limit boosts (these plugins work WITHOUT a key, free):
# CAIRN_GITHUB_KEY=        # github plugin: 60/hr → 5,000/hr (https://github.com/settings/tokens)
# CAIRN_URLSCAN_KEY=       # urlscan plugin: higher community limit

# ── Misc ──────────────────────────────────────────────────────────────
CAIRN_LOG_LEVEL=INFO
# Daily-quota'd free plugins (e.g. hackertarget ~50/day) are OFF by default —
# the brain only uses truly-free / rate-limited-only sources. Set to 1 to opt in:
# CAIRN_ALLOW_DAILY_LIMITED=0
